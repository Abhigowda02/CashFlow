# Set these as environment variables in the deployment host; this file is not auto-loaded.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/cashflow?sslmode=require
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://cashflow.example.com
BANK_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Notification and Reminder delivery (SMTP)
# If unconfigured or MOCK_DELIVERY=true, the system runs in safe mock mode with mailto and preview fallback
MOCK_DELIVERY=false
# Set true to automatically send ordinary email reminders whenever the queue is generated.
# Legal-demand drafts and SMS/WhatsApp links remain manual.
AUTO_REMINDERS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=secret_smtp_password
SMTP_FROM=CashFlow Alerts <alerts@example.com>
